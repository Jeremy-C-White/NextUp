# TMDB API Key for fetching watch providers, high-res backdrops, and discovery.
VITE_TMDB_API_KEY=

# AIOStreams Base URL
# E.g. https://aiostreams.example.com/stremio/.../manifest.json
VITE_AIOSTREAMS_BASE_URL=

# Optional server-only override for the same-origin AIOStreams proxy. When it
# is omitted, the server uses VITE_AIOSTREAMS_BASE_URL. Only this installation's
# manifest and stream JSON endpoints are allowed through the proxy.
AIOSTREAMS_PROXY_BASE_URL=
