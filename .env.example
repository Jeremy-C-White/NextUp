# TMDB API Key for fetching watch providers, high-res backdrops, and discovery.
VITE_TMDB_API_KEY=

# AIOStreams Base URL
# E.g. https://aiostreams.example.com/stremio/.../manifest.json
VITE_AIOSTREAMS_BASE_URL=

# Server-side MKV/HLS conversion. FFmpeg and FFprobe must be installed.
# Add comma-separated direct-stream hosts only when your provider uses a host
# other than the configured AIOStreams or built-in debrid domains.
ALLOWED_STREAM_DOMAINS=
TRANSCODER_SECRET=
